# Dependencies
node_modules/

# Build outputs
dist/
dist-app/
apps/*/dist/
packages/*/dist/
*.tsbuildinfo

# Redistributable binaries are delivered through GitHub Releases, not Git
resources/ffmpeg/win32-x64/ffmpeg.exe
resources/ffmpeg/win32-x64/ffprobe.exe
resources/ffmpeg/linux-x64/ffmpeg
resources/ffmpeg/linux-x64/ffprobe

# Generated JavaScript must not live beside TypeScript sources
apps/desktop/src/**/*.js
apps/desktop/src/**/*.js.map

# Test and coverage artifacts
coverage/
.vitest/
test-results/
playwright-report/

# Runtime data and logs
*.log
*.db
*.db-shm
*.db-wal
store.json
*.partial

# Local tooling and operating system files
.codegraph/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Environment files
.env
.env.*
!.env.example

